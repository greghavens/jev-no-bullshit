_MAIN_INPUT_KEYS = ("command", "cmd", "file_path", "path", "pattern", "url", "query", "description", "prompt")


def short_input(tool_input: str) -> str:
    try:
        parsed = json.loads(tool_input)
    except ValueError:
        parsed = None
    if isinstance(parsed, dict):
        for key in _MAIN_INPUT_KEYS:
            if parsed.get(key):
                value = parsed[key]
                return one_line(" ".join(value) if isinstance(value, list) else str(value), 80)
    return one_line(tool_input, 80)


def short_result(result: str) -> str:
    lines = [line for line in result.splitlines() if line.strip()]
    return one_line(lines[-1], 80) if lines else "(empty)"


def build_reason(flagged: dict[str, list[str]], state: dict, dropped_actions: int) -> str:
    lines = [f"{MARKER} Double-check these before you finish:"]
    for t in TYPES:
        for qid in flagged.get(t, []):
            index = int(qid.rsplit("_", 1)[1][1:])
            if t == PALTER:
                action = state["actions"][index]
                label = f"{action['tool']}: {short_input(action['input'])} -> {short_result(action['result'])}"
                lines.append("- " + FEEDBACK[t].format(n=dropped_actions + index + 1, label=label))
            else:
                quote = json.dumps(one_line(state["sentences"][index], 300), ensure_ascii=False)
                lines.append("- " + FEEDBACK[t].format(quote=quote))
    lines.append(
        "Then rewrite your summary plainly: what you did, what you verified and how, and what failed or is unfinished."
    )
    return "\n".join(lines)


