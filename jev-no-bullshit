# Transcripts


def read_jsonl(path: str | None) -> list[dict]:
    if not path:
        return []
    entries = []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if isinstance(obj, dict):
                    entries.append(obj)
    except OSError:
        return []
    return entries


# Wrappers Claude Code and Codex put around text that the user did not type.
_NOT_TYPED_PREFIXES = (
    "<command-name>",
    "<command-message>",
    "<local-command-",
    "<task-notification>",
    "<system-reminder>",
    "<user-prompt-submit-hook>",
    "<hook_prompt",
    "<environment_context>",
    "<user_instructions>",
    "<user_shell_command>",
    "<turn_aborted>",
    "<permissions",
    "<INSTRUCTIONS>",
    "# AGENTS.md instructions",
    "[Request interrupted",
)


def is_real_user_text(text: str) -> bool:
    stripped = text.strip()
    if not stripped or MARKER in stripped[:300]:
        return False
    return not stripped.startswith(_NOT_TYPED_PREFIXES)


def stringify(value) -> str:
    if value is None:
        return ""
    if isinstance(value, str):
        return value
    return json.dumps(value, ensure_ascii=False)


def input_text(tool_input) -> str:
    """A tool input that holds multi-line text (file content, a script) as `key: value` lines, strings as
    written, so its lines read and clip as lines rather than one escaped JSON string."""
    if not isinstance(tool_input, dict) or not any(isinstance(v, str) and "\n" in v for v in tool_input.values()):
        return stringify(tool_input)
    lines = []
    for key, value in tool_input.items():
        text = stringify(value)
        lines.append(f"{key}:\n{text}" if "\n" in text else f"{key}: {text}")
    return "\n".join(lines)


def content_text(content) -> str:
    """Flatten a message or tool result content (string or list of blocks) to text."""
    if content is None:
        return ""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for block in content:
            if isinstance(block, str):
                parts.append(block)
            elif isinstance(block, dict):
                if isinstance(block.get("text"), str):
                    parts.append(block["text"])
                elif block.get("type") in ("image", "input_image"):
                    parts.append("[image]")
        return "\n".join(parts)
    return stringify(content)


# ripgrep's stand-in for a matching line too long to print. Jev read "12:[Omitted long matching line]"
# as no match, and flagged a reply saying the search found the string on line 12.
_RG_LONG_LINE_RE = re.compile(r"^((?:[^\n:]+:)?)(\d+):\[Omitted long matching line\]$", re.M)


# pytest's progress line: one character per test. Jev read "...." as nothing, and flagged "4 of 13
# tests have passed so far" read from it.
_PYTEST_PROGRESS_RE = re.compile(r"^(?:\S+\.py )?([.FEsxX]+)(?: +\[ *\d+%\])?$", re.M)
_PYTEST_MARKS = {".": "passed", "F": "failed", "E": "errors", "s": "skipped", "x": "xfailed", "X": "xpassed"}


def plain_result(result: str, input_text_: str = "") -> str:
    """A result with tool shorthand written out."""
    result = _RG_LONG_LINE_RE.sub(r"\1\2:[line \2 matches; it is too long to print]", result)
    if "pytest" in input_text_ or "pytest" in result:
        result = with_pytest_counts(result)
    return result


def with_pytest_counts(result: str) -> str:
    """A pytest result with its progress marks counted after it."""
    if result:
        marks = "".join(m.group(1) for m in _PYTEST_PROGRESS_RE.finditer(result))
        if marks:
            counts = ", ".join(f"{marks.count(c)} {name}" for c, name in _PYTEST_MARKS.items() if marks.count(c))
            result += f"\n[pytest progress marks above, one per test: {counts}]"
    return result


def make_action(tool: str, tool_input, result: str | None, error: bool) -> dict:
    text = input_text(tool_input)
    return {
        "tool": tool or "unknown",
        "input": text,  # clipped in build_state, against the summary
        "result": plain_result(result, text) if result is not None else NO_RESULT,  # clipped in build_state, against the summary
        "error": bool(error),
    }


def split_calls(calls: list[dict]) -> tuple[list[dict], list[dict]]:
    """Return (actions since the task, earlier actions) from calls marked with "now"."""
    actions = [make_action(c["tool"], c["input"], c["result"], c["error"]) for c in calls if c["now"]]
    earlier = [make_action(c["tool"], c["input"], c["result"], c["error"]) for c in calls if not c["now"]]
    return actions, earlier


def parse_claude(entries: list[dict]) -> tuple[str, list[dict], str | None, list[dict]]:
    """Return (task, actions, model, earlier actions) from a Claude Code transcript.

    actions are the tool calls since the task message; earlier actions are the ones before it, which
    back up what the summary says about previous turns.

    A plugin may append a trimmed copy of the conversation to the transcript (fast-jev-compaction
    does, after every turn), with the original timestamps and fewer tool calls. So each tool call is
    counted once, by its ID, and the turn is found by timestamp rather than by place in the file.
    """
    task_index, task, task_time = -1, "", ""
    for i, e in enumerate(entries):
        if e.get("type") != "user" or e.get("isMeta") or e.get("isSidechain") or e.get("isCompactSummary"):
            continue
        content = (e.get("message") or {}).get("content")
        if isinstance(content, list) and any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
            continue
        text = content_text(content)
        if is_real_user_text(text) and str(e.get("timestamp") or "") >= task_time:
            task_index, task, task_time = i, text.strip(), str(e.get("timestamp") or "")

    def is_now(n: int, e: dict) -> bool:
        stamp = str(e.get("timestamp") or "")
        return stamp > task_time if stamp and task_time else n > task_index

    calls: list[dict] = []
    by_id: dict[str, dict] = {}
    model = None
    for n, e in enumerate(entries):
        if e.get("isSidechain"):
            continue
        message = e.get("message") or {}
        content = message.get("content")
        if e.get("type") == "assistant":
            if is_now(n, e) and message.get("model") and message["model"] != "<synthetic>":
                model = message["model"]
            for block in content if isinstance(content, list) else []:
                if isinstance(block, dict) and block.get("type") == "tool_use":
                    if block.get("id") in by_id:
                        continue  # a copy of a call already seen
                    call = {"tool": block.get("name"), "input": block.get("input"), "result": None, "error": False, "now": is_now(n, e), "time": str(e.get("timestamp") or "")}
                    calls.append(call)
                    if block.get("id"):
                        by_id[block["id"]] = call
        elif e.get("type") == "user":
            for block in content if isinstance(content, list) else []:
                if isinstance(block, dict) and block.get("type") == "tool_result":
                    call = by_id.get(block.get("tool_use_id"))
                    if call is not None and call["result"] is None:  # a copy's result may be trimmed
                        call["result"] = content_text(block.get("content"))
                        call["error"] = bool(block.get("is_error"))
        elif e.get("type") == "attachment":
            # A background agent or command reports back in a task notification naming the call that
            # started it; that call's own result only says it started.
            text = (e.get("attachment") or {}).get("prompt")
            if isinstance(text, str) and text.lstrip().startswith("<task-notification>"):
                start = text.find("<tool-use-id>") + len("<tool-use-id>")
                call = by_id.get(text[start : text.find("</tool-use-id>", start)])
                if call is not None and text not in (call["result"] or ""):
                    call["result"] = ((call["result"] or "") + "\n" + text).strip()
    if all(c["time"] for c in calls):
        calls.sort(key=lambda c: c["time"])  # a call made after a copy may sit before the copy's calls
    if model is None:  # the model may be named only before the task message
        for e in reversed(entries[: task_index + 1]):
            m = (e.get("message") or {}).get("model") if e.get("type") == "assistant" else None
            if m and m != "<synthetic>":
                model = m
                break
    actions, earlier = split_calls(calls)
    return task, actions, model, earlier


_EXIT_CODE_RE = re.compile(r"^(?:Exit code:|Process exited with code)\s*(-?\d+)", re.MULTILINE)


def codex_output(output) -> tuple[str, bool]:
    """Return (text, error) for a Codex function_call_output / custom_tool_call_output."""
    exit_code = None
    success = None
    if isinstance(output, str):
        try:
            parsed = json.loads(output)
        except ValueError:
            parsed = None
        if isinstance(parsed, dict) and ("output" in parsed or "metadata" in parsed):
            output = parsed  # legacy {"output": ..., "metadata": {"exit_code": ...}}
    if isinstance(output, dict):
        metadata = output.get("metadata") if isinstance(output.get("metadata"), dict) else {}
        exit_code = metadata.get("exit_code")
        success = output.get("success")
        text = content_text(output.get("output", output.get("content")))
    else:
        text = content_text(output)
    if exit_code is None:
        match = _EXIT_CODE_RE.search(text[:500])
        if match:
            exit_code = int(match.group(1))
    error = success is False or (isinstance(exit_code, int) and exit_code != 0)
    return text, error


def _codex_items(entries: list[dict]):
    """Yield (kind, payload) from rollout lines {"type": ..., "payload": {...}} or legacy bare items."""
    for e in entries:
        if isinstance(e.get("payload"), dict) and e.get("type") in (
            "response_item",
            "event_msg",
            "turn_context",
            "session_meta",
            "compacted",
        ):
            yield e["type"], e["payload"]
        elif "type" in e:
            yield "response_item", e


def parse_codex(entries: list[dict]) -> tuple[str, list[dict], str | None, list[dict]]:
    """Return (task, actions, model, earlier actions) from a Codex rollout file."""
    items = list(_codex_items(entries))

    # Prefer user_message events (what the user typed); fall back to user message items.
    candidates = [
        (i, p.get("message") or "")
        for i, (kind, p) in enumerate(items)
        if kind == "event_msg" and p.get("type") == "user_message"
    ]
    if not candidates:
        candidates = [
            (i, content_text(p.get("content")))
            for i, (kind, p) in enumerate(items)
            if kind == "response_item" and p.get("type") == "message" and p.get("role") == "user"
        ]
    task_index, task = -1, ""
    for i, text in candidates:
        if is_real_user_text(text):
            task_index, task = i, text.strip()

    calls: list[dict] = []
    by_id: dict[str, dict] = {}
    model = None
    for kind, p in items:
        if kind == "turn_context" and p.get("model"):
            model = p["model"]
    for n, (kind, p) in enumerate(items):
        if kind != "response_item":
            continue
        ptype = p.get("type")
        if ptype in ("function_call", "custom_tool_call", "local_shell_call", "tool_search_call", "web_search_call"):
            if ptype == "function_call":
                tool, tool_input = p.get("name"), p.get("arguments")
            elif ptype == "custom_tool_call":
                tool, tool_input = p.get("name"), p.get("input")
            elif ptype == "local_shell_call":
                tool, tool_input = "local_shell", (p.get("action") or {}).get("command", p.get("action"))
            elif ptype == "tool_search_call":
                tool, tool_input = "tool_search", p.get("arguments")
            else:
                tool, tool_input = "web_search", p.get("action")
            call = {"tool": tool, "input": tool_input, "result": None, "error": False, "now": n > task_index}
            if ptype == "web_search_call":
                call["result"] = p.get("status") or ""
            calls.append(call)
            if p.get("call_id"):
                by_id[p["call_id"]] = call
        elif ptype in ("function_call_output", "custom_tool_call_output", "tool_search_output"):
            call = by_id.get(p.get("call_id"))
            if call is not None:
                raw = p.get("output") if "output" in p else p.get("tools")
                call["result"], call["error"] = codex_output(raw)
    actions, earlier = split_calls(calls)
    return task, actions, model, earlier


def hook_text(text: str) -> str | None:
    """The feedback in a message a hook or plugin sent in the user's place, or None for any other text."""
    stripped = text.strip()
    if stripped.startswith("Stop hook feedback:"):
        return stripped[len("Stop hook feedback:") :].strip()  # its attachment copy names the hook
    if stripped.startswith("The jev-no-bullshit plugin sent a message:"):
        return stripped
    if stripped.startswith("<hook_prompt"):
        return re.sub(r"</?hook_prompt[^>]*>", "", stripped).strip()
    if MARKER in stripped[:300]:
        return stripped
    return None


_QUOTED_RE = re.compile(r'"(?:[^"\\]|\\.)*"')


def plugin_note(text: str) -> str:
    """This plugin's earlier note cut to what it asked about. Its verdicts ("None of your actions show
    this") were taken as evidence against the revision, raising true claims backed by tool output to
    0.84; without the note, a reply saying it fixed "the flagged sentence" had nothing to refer to."""
    items = []
    for line in text.splitlines():
        if not line.startswith("- "):
            continue
        kind = line[2:].split(":", 1)[0]
        quoted = _QUOTED_RE.search(line)
        items.append(f"{kind}: {quoted.group()}" if quoted else kind)
    return f"{MARKER} asked the assistant to double-check: " + "; ".join(items) if items else MARKER


def without_reply(messages: list[dict], reply: str) -> list[dict]:
    """The messages up to, not including, the reply being checked.

    The Stop hook can run before the host writes the reply to the transcript. Dropping the last
    assistant message then dropped the previous reply and the person's request after it, so the
    reply is dropped only where its own text is found.
    """
    reply = reply.strip()
    for i in range(len(messages) - 1, -1, -1):
        if messages[i]["role"] == "assistant" and messages[i]["text"].strip() == reply:
            return messages[:i]
    return messages


def conversation_claude(entries: list[dict], reply: str) -> list[dict]:
    """Return the session's messages before the reply being checked, oldest first: what the person
    typed, what the assistant said (its replies within this turn too), and what hooks and plugins sent
    in the user's place ("hook").

    Each is {"role", "text"}. A trimmed copy of the conversation appended to the file repeats them, so
    each is counted once, by timestamp and text; a hook's note recorded twice in a row (as a message and
    an attachment) is counted once.
    """
    messages: dict[tuple[str, str], dict] = {}

    def add(stamp: str, role: str, text: str, source: str = "") -> None:
        # A hook's note is kept by its text alone, so the two records of one note compare equal; the
        # attachment's copy names the hook's command, which the message copy lacks.
        messages.setdefault((stamp, text), {"role": role, "text": text, "source": source})

    for e in entries:
        stamp = str(e.get("timestamp") or "")
        if e.get("isSidechain") or e.get("isCompactSummary"):
            continue
        if e.get("type") == "attachment":
            a = e.get("attachment") or {}
            source = ""
            if a.get("type") == "hook_additional_context":
                text = content_text(a.get("content"))
            elif a.get("type") == "hook_blocking_error":
                blocking = a.get("blockingError") or {}
                text = stringify(blocking.get("blockingError"))
                if blocking.get("command"):
                    source = f'{a.get("hookEvent") or a.get("hookName") or "A"} hook `{blocking["command"]}`'
            else:
                continue
            if text.strip():
                add(stamp, "hook", text.strip(), source)
            continue
        if e.get("type") not in ("user", "assistant"):
            continue
        content = (e.get("message") or {}).get("content")
        if isinstance(content, list) and any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
            continue
        if e["type"] == "assistant" and isinstance(content, list):
            content = [b for b in content if isinstance(b, dict) and b.get("type") == "text"]
        text = content_text(content).strip()
        if not text:
            continue
        if e["type"] == "user":
            note = hook_text(text)
            if note is not None:
                add(stamp, "hook", note)
                continue
            if e.get("isMeta") or not is_real_user_text(text):
                continue
        add(stamp, e["type"], text)
    ordered: list[dict] = []
    for _, m in sorted(messages.items(), key=lambda kv: kv[0][0]):
        if m["role"] == "hook" and MARKER in m["text"][:300]:
            m = {**m, "text": plugin_note(m["text"])}
        if m["role"] == "hook" and ordered and ordered[-1]["role"] == "hook" and ordered[-1]["text"] == m["text"]:
            ordered[-1]["source"] = ordered[-1]["source"] or m["source"]
            continue
        ordered.append(m)
    return without_reply(
        [{"role": m["role"], "text": f'{m["source"]}: {m["text"]}' if m.get("source") else m["text"]} for m in ordered],
        reply,
    )


def conversation_codex(entries: list[dict], reply: str) -> list[dict]:
    """Return the session's messages before the reply being checked from a Codex rollout file, as
    conversation_claude does."""
    ordered = []
    for kind, p in _codex_items(entries):
        if kind == "response_item" and p.get("type") == "message" and p.get("role") in ("user", "assistant"):
            text = content_text(p.get("content")).strip()
            if not text:
                continue
            note = hook_text(text) if p["role"] == "user" else None
            if note is not None:
                ordered.append({"role": "hook", "text": note})
            elif p["role"] == "assistant" or is_real_user_text(text):
                ordered.append({"role": p["role"], "text": text})
    return without_reply(ordered, reply)


def read_transcript(path: str | None, parse) -> tuple[str, list[dict], str | None, int, list[dict]]:
    """Parse the transcript, re-reading briefly while tool calls still lack results.

    Return (task, actions, model, number of tool calls still without a result, earlier actions).
    """
    deadline = time.monotonic() + TRANSCRIPT_WAIT_SECONDS
    while True:
        task, actions, model, earlier = parse(read_jsonl(path))
        pending = sum(1 for a in actions if a["result"] == NO_RESULT)
        if not pending or time.monotonic() >= deadline:
            return task, actions, model, pending, earlier
        time.sleep(0.1)


# ---------------------------------------------------------------------------
# Jev state and questions


# TypeSafe doesn't publish Jev's tokenizer. Its counts match Qwen3.5's on English and code, but
# that tokenizer isn't in the standard library, so estimate from the pieces it splits text into.
# Letter runs are split at case changes, so a random ID counts as many short pieces. The weights are
# fitted to Qwen3.5's counts on real tool calls. Other characters use Jev's measured counts: 1 for each
# in the Basic Multilingual Plane (accents, dashes, CJK), 2 above it (emoji). On states of 30 or more
# strings the estimate lands within 10% of the true count (median 1.01x), and within 4% on the live API.
_TOKEN_PIECE_RE = re.compile(r"[A-Z]?[a-z]+|[A-Z]+(?![a-z])|[0-9]|[ \t\n\r\f\v]+|[!-/:-@\[-`{-~]+|[^\x00-\x7f]")
SHORT_WORD_TOKENS = 1.13  # a letter piece of up to 3 letters
LONG_WORD_TOKENS_PER_LETTER = 0.17
DIGIT_TOKENS = 1.0
WHITESPACE_RUN_TOKENS = 0.39
PUNCTUATION_TOKENS_PER_CHAR = 0.57
BMP_CHAR_TOKENS = 1.0
ASTRAL_CHAR_TOKENS = 2.0
# Budgets are divided by this so an estimate that runs a little low still fits: the live API came in
# at most 3.5% above the estimate on full states.
ESTIMATE_MARGIN = 1.05
# If Jev refuses anyway, the state is unusual for the estimator (such as long random IDs), so the retry
# cuts every budget to this fraction rather than shaving a few percent and getting refused again.
RETRY_BUDGET_SCALE = 0.8


def estimate_tokens(value) -> float:
    """Estimate Jev's token count for a state value, the way Jev renders objects."""
    if isinstance(value, dict):
        return CONTAINER_OVERHEAD_TOKENS + sum(
            KEY_OVERHEAD_TOKENS + estimate_tokens(k) + estimate_tokens(v) for k, v in value.items()
        )
    if isinstance(value, list):
        return CONTAINER_OVERHEAD_TOKENS + sum(ITEM_OVERHEAD_TOKENS + estimate_tokens(v) for v in value)
    tokens = 0.0
    for piece in _TOKEN_PIECE_RE.findall(value if isinstance(value, str) else json.dumps(value)):
        first = piece[0]
        if not first.isascii():
            tokens += ASTRAL_CHAR_TOKENS if ord(first) > 0xFFFF else BMP_CHAR_TOKENS
        elif first.isalpha():
            tokens += SHORT_WORD_TOKENS if len(piece) <= 3 else LONG_WORD_TOKENS_PER_LETTER * len(piece)
        elif first.isdigit():
            tokens += DIGIT_TOKENS
        elif first.isspace():
            tokens += WHITESPACE_RUN_TOKENS
        else:
            tokens += PUNCTUATION_TOKENS_PER_CHAR * len(piece)
    return tokens


def question_tokens(question: dict) -> float:
    criteria = question.get("criteria") or {}
    text = estimate_tokens(question["instructions"]) + sum(estimate_tokens(v) for v in criteria.values())
    return QUESTION_OVERHEAD_TOKENS + (CRITERIA_OVERHEAD_TOKENS if criteria else 0) + QUESTION_TEXT_SCALE * text


def state_token_budget(asked: int, palters: int, scale: float = 1.0) -> float:
    """Tokens the state may use: STATE_BASE_TOKENS, and more for each sentence and action asked about."""
    budget = STATE_BASE_TOKENS + STATE_PER_CANDIDATE_TOKENS * asked + STATE_PER_PALTER_TOKENS * palters
    return min(budget, STATE_MAX_TOKENS) * scale


def state_token_limit(scale: float = 1.0) -> float:
    """Jev's own limit on the state: 32k less the request overhead and the longest question."""
    # Index 999: an extra digit is one token, well inside ESTIMATE_MARGIN.
    longest = max(question_tokens(make_question(t, 999)) for t in (*SENTENCE_QUESTIONS, PALTER))
    return STATE_AND_QUESTION_TOKEN_LIMIT * scale / ESTIMATE_MARGIN - REQUEST_OVERHEAD_TOKENS - longest


# Every action's JSON is rewritten without the spaces it was printed with, before anything is clipped. A
# list of objects keeps one entry per line, whole, so a clip that keeps each line's start still keeps
# every entry's first fields (its id or name).
_GUTTER_RE = re.compile(r"^( *\d+\t)(.*)$")


def _json_value(text: str):
    try:
        value = json.loads(text)
    except ValueError:
        return None
    return value if isinstance(value, (dict, list)) else None


def _dump(value) -> str:
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))


def _has_entries(value) -> bool:
    return isinstance(value, list) and any(isinstance(v, (dict, list)) for v in value)


def _dump_lines(value, indent: str = "") -> str:
    """Compact JSON with each entry of a list of objects or lists whole on one line of its own."""
    inner = indent + " "
    if _has_entries(value):
        return "[\n" + ",\n".join(inner + _dump(v) for v in value) + "\n" + indent + "]"
    if isinstance(value, dict) and any(_has_entries(v) for v in value.values()):
        return "{\n" + ",\n".join(inner + _dump(k) + ":" + _dump_lines(v, inner) for k, v in value.items()) + "\n" + indent + "}"
    return _dump(value)


def compact_text(text: str) -> str:
    """Text with its JSON rewritten compactly: one JSON value (read with line numbers or not), or JSON lines."""
    lines = text.split("\n")
    gutters = [_GUTTER_RE.match(line) for line in lines]
    numbered = len(lines) > 1 and all(g or not line.strip() for g, line in zip(gutters, lines))
    whole = _json_value("\n".join(g.group(2) if g else line for g, line in zip(gutters, lines)) if numbered else text)
    if whole is not None:
        return _dump_lines(whole)
    out = []
    for g, line in zip(gutters, lines):
        prefix, body = (g.group(1), g.group(2)) if g else ("", line)
        value = _json_value(body)
        out.append(line if value is None else prefix + _dump(value))
    return "\n".join(out)


def compact_input(text: str) -> str:
    fields = json_object(text)
    if fields is None:
        return compact_text(text)
    return json.dumps({k: compact_text(v) if isinstance(v, str) else v for k, v in fields.items()}, ensure_ascii=False)


def compact_action(action: dict) -> dict:
    action = strip_codex(action)
    result = compact_text(_SANDBOX_NOISE_LINE_RE.sub("", action["result"]))
    compacted = {**action, "input": compact_input(action["input"]), "result": result, "error": bool(action.get("error"))}
    # Jev is unreliable at counting. Give it the exact number of nonblank lines
    # before any clipping, without assuming that a line is a match or a record.
    lines = sum(bool(line.strip()) for line in compacted["result"].splitlines())
    if lines > 1:
        compacted["result_line_count"] = lines
    return compacted


def wire_action(action: dict) -> str:
    """An action as Jev is sent it: one string, which costs fewer tokens than an object of four fields."""
    if action.get("omitted"):
        n = action["omitted"]
        return f"…{n} action{'s' if n > 1 else ''} omitted…"
    if "omitted_lines" in action:
        # Held for its index: only its result's evidence lines, if any; the rest is said to be left out,
        # since an empty result read as one that printed nothing.
        n, found = action["omitted_lines"], action["result"]
        lines = f" [{n} line{'s' if n != 1 else ''} omitted{', except:' if found else ''}]" if n else ""
    else:
        lines = f" [{action['result_line_count']} lines]" if action.get("result_line_count") else ""
    rerun = f"\n=> later, {action['rerun_by']} did not fail: {action['rerun']}" if action.get("rerun") else ""
    result = f" {action['result']}" if action["result"] or "omitted_lines" not in action else ""
    return f"{action['tool']}{' (error)' if action['error'] else ''}: {action['input']}\n=>{lines}{result}{rerun}"


def wire_state(state: dict) -> dict:
    """The state as Jev is sent it. The dict form stays for callout_key, build_reason and is_mechanics.
    An empty `conversation` or `earlier_actions` is left out: its key and brackets cost 4.5 tokens a call
    that the evidence lines use instead."""
    wired = {**state, "actions": [wire_action(a) for a in state["actions"]]}
    return {k: v for k, v in wired.items() if v or k not in ("conversation", "earlier_actions")}


def callout_target(action: dict) -> str:
    """What names an action across attempts: its tool and the head and tail of its input and result
    before any clipping, which changes with the reply and the room."""
    return f"{action['tool']}\0{action['input'][:150]}\0{action['input'][-150:]}\0{action['result'][:1000]}\0{action['result'][-1000:]}"


def fill(actions: list[dict], tokens: float, clipped, evidence: tuple[set[str], set[str]], stems: set[str]) -> list[dict]:
    """The actions whole if they fit `tokens`, else each input and result cut to the largest length that
    fits, or `clipped` if even the fixed clips don't."""

    def cut(a: dict, limit: int) -> dict:
        result = clip_result(a["result"], evidence, limit, a.get("target", False))
        return {**a, "input": clip_input(a["input"], evidence, stems, limit), "result": result}

    def cost(items: list[dict]) -> float:
        return sum(ITEM_OVERHEAD_TOKENS + estimate_tokens(wire_action(a)) for a in items)

    if not actions or cost(actions) <= tokens:
        return list(actions)
    low, high = RESULT_CLIP_CHARS, max(max(len(a["input"]), len(a["result"])) for a in actions)
    if cost([cut(a, low) for a in actions]) > tokens:
        return [clipped(a) for a in actions]
    while high - low > 100:
        mid = (low + high) // 2
        low, high = (mid, high) if cost([cut(a, mid) for a in actions]) <= tokens else (low, mid)
    return [cut(a, low) for a in actions]


def shrink(actions: list[dict], tokens: float, evidence: tuple[set[str], set[str]], stems: set[str]) -> list[dict]:
    """The actions cut below the fixed clips, inputs a third as long as results, to the largest length
    that fits `tokens`, or to SHRINK_FLOOR_CHARS."""

    def cut(a: dict, limit: int) -> dict:
        short = INPUT_CLIP_CHARS * limit // RESULT_CLIP_CHARS
        result = clip_result(a["result"], evidence, limit, a.get("target", False))
        return {**a, "input": clip_input(a["input"], evidence, stems, short), "result": result}

    def cost(items: list[dict]) -> float:
        return sum(ITEM_OVERHEAD_TOKENS + estimate_tokens(wire_action(a)) for a in items)

    low, high = SHRINK_FLOOR_CHARS, RESULT_CLIP_CHARS
    if cost([cut(a, low) for a in actions]) > tokens:
        return [cut(a, low) for a in actions]
    while high - low > 40:
        mid = (low + high) // 2
        low, high = (mid, high) if cost([cut(a, mid) for a in actions]) <= tokens else (low, mid)
    return [cut(a, low) for a in actions]


# A later command that checks the work whatever it ran before: a build, test runner or type check.
_CHECK_COMMAND_RE = re.compile(
    r"\bcargo\s+(?:build|test|check|clippy|nextest|run)\b|\bmake\b|\bnpm\s+(?:test|run)\b|\bpytest\b|\bunittest\b|"
    r"\bgo\s+(?:test|build|vet)\b|\btsc\b|\bscripts/test\w*"
)
# A file a command or its error names: a path with a directory, or a name with a source file's extension.
_FILE_RE = re.compile(r"(?:[\w.-]+/)+[\w.-]+\.\w{1,6}\b|\b[\w-]+\.(?:rs|py|ts|tsx|js|jsx|go|c|h|cc|cpp|java|kt|rb|sh|toml|json|ya?ml|sql)\b")
# A compiler's location line under its error ("  --> src/worker.rs:141:5").
_LOCATION_LINE_RE = re.compile(r"^\s*-->\s")


def failure_files(action: dict) -> set[str]:
    """The files the action's input names, and those its failure lines name."""
    text = action["result"].replace("\\n", "\n")
    lines = [line for line in text.splitlines() if _FAILURE_RE.search(line) or _FAILURE_LINE_RE.search(line) or _LOCATION_LINE_RE.match(line)]
    return {m.lstrip("./") for m in _FILE_RE.findall(action["input"] + "\n" + "\n".join(lines))}


def _failed(action: dict) -> bool:
    return action["failed"] if "failed" in action else shows_failure(action)


def later_runs(actions: list[dict], j: int) -> tuple[list[dict], list[dict]]:
    """(reruns, touches) after the failed action j: the later runs of its command or of a build or test
    command, and the later edits or writes of a file its input or failure lines name."""
    family = command_family(actions[j])
    files = failure_files(actions[j])
    reruns, touches = [], []
    for later in actions[j + 1 :]:
        if later["mechanics"] if "mechanics" in later else is_mechanics(later):
            continue
        shell = later["tool"] in _SHELL_TOOLS
        if (family and command_family(later) == family) or (shell and _CHECK_COMMAND_RE.search(later["input"])):
            reruns.append(later)
        elif later["tool"] in _WRITE_TOOLS and any(f in later["input"] for f in files):
            touches.append(later)
    return reruns, touches


def fixed_later(actions: list[dict], j: int) -> bool:
    """Whether the failed action j's command, or a build or test command, ran again later in the turn and
    the newest such run did not fail.

    Such a failure is not asked the paltering question: with the later run attached ("=> ran again later
    without failing") Jev still flagged it (17:22:04 a0/a3/a4, 11:54:21 a0), though the reply's result
    stood. A failure followed only by an edit, or by a shell command that rewrites the file (the 12:28
    pipeline's `sed -i`), or whose later run failed too, is still asked."""
    reruns, _ = later_runs(actions, j)
    return bool(reruns) and not _failed(reruns[-1])


def rerun_context(actions: list[dict], j: int) -> dict:
    """{"rerun": the end of a later edit's result, "rerun_by": its label} when no command ran after the
    failed action j (a passing run is fixed_later; a failing one attaches nothing) and the newest later
    edit or write of a file j's input or failure lines name did not fail, else {}. The paltering
    question is still asked, and Jev sees what followed the failure.

    A shell command that rewrites the file is no such edit: the 12:28 pipeline's script failed
    validation, and the `sed -i` that deleted the entities it failed on, then ran it cleanly, was the
    paltering the reply left out."""
    reruns, touches = later_runs(actions, j)
    if reruns or not touches or _failed(touches[-1]):
        return {}
    later = touches[-1]
    return {"rerun": tail(" ".join(later["result"].split()), RERUN_RESULT_CHARS) or "(no output)",
            "rerun_by": action_label(later, SIDE_EFFECT_CHARS)}


def palter_targets(actions: list[dict]) -> list[int]:
    """The actions asked the paltering question: of the newest MAX_PALTER_ACTIONS whose result shows a
    failure, those no later run fixed (fixed_later). The slots those free are not given to older failures."""
    # All three are read before clipping (build_state), which can cut out what shows them.
    failed = [_failed(a) for a in actions]
    mechanics = [a["mechanics"] if "mechanics" in a else is_mechanics(a) for a in actions]
    newest = [j for j in range(len(actions)) if failed[j] and not mechanics[j]][-MAX_PALTER_ACTIONS:]
    return [j for j in newest if not (actions[j]["fixed_later"] if "fixed_later" in actions[j] else fixed_later(actions, j))]


def held_entry(action: dict, evidence: tuple[set[str], set[str]]) -> tuple[int, dict]:
    """(evidence hits, entry) for an action held only for its index: its input's first words and the
    pieces of it that check something, and its result's evidence lines, with the count of lines left out."""
    found = " | ".join(evidence_lines(action["result"], evidence, BRIEF_EVIDENCE_CHARS))
    short = {k: v for k, v in action.items() if k not in ("result_line_count", "rerun", "rerun_by")}
    label = action_label(action, SIDE_EFFECT_CHARS)
    short.update(input=label + check_pieces(action["input"], label, HELD_CHECK_CHARS), result=found,
                 omitted_lines=sum(bool(line.strip()) for line in action["result"].splitlines()))
    return evidence_hits(short["input"] + "\n" + found, evidence), short


def build_state(
    task: str, actions: list[dict], summary: str, earlier: list[dict] = (), conversation: list[dict] = (), scale: float = 1.0
) -> tuple[dict, int]:
    """Return (state, dropped) where dropped counts the oldest actions left out to fit the token budget.

    The state is sized by what is asked (state_token_budget), and everything in it beyond the task, the
    newest messages, the sentences and the turn's actions is there because it bears on a sentence asked
    about: its numbers, code terms or action verbs (see evidence_terms, earlier_lines).
    """
    entries = sentences_with_headings(summary)
    asked = candidates(summary)
    claims = "\n".join(entries[i][1] for i in asked)
    evidence = evidence_terms(claims)
    stems = action_stems(claims)
    per_sentence = [(evidence_terms(entries[i][1]), action_stems(entries[i][1]), entries[i][1]) for i in asked]
    # A result that is only progress marks, read from a file an earlier pytest run wrote ("tail
    # out.txt" printing "...."), names no pytest itself.
    if any("pytest" in a["input"] for a in [*earlier, *actions]):
        actions = [
            {**a, "result": with_pytest_counts(a["result"])} if _PYTEST_PROGRESS_RE.fullmatch(a["result"].strip()) else a
            for a in actions
        ]
    actions = [compact_action(a) for a in actions]
    # Whether it failed and what names it are read before clipping, which can cut out both.
    actions = [
        {**a, "failed": shows_failure(a), "mechanics": is_mechanics(a), "callout": callout_target(a), "turn": n}
        for n, a in enumerate(actions)
    ]
    actions = [{**a, "fixed_later": a["failed"] and fixed_later(actions, n)} for n, a in enumerate(actions)]
    targets = palter_targets(actions)
    for j in targets:
        actions[j] = {**actions[j], "target": True, **rerun_context(actions, j)}
    earlier = [compact_action(a) for a in earlier]
    budget = state_token_budget(len(asked), len(targets), scale)

    def clipped(a: dict) -> dict:
        return {**a, "input": clip_input(a["input"], evidence, stems), "result": clip_result(a["result"], evidence, failures=a.get("target", False))}

    def cost(value) -> float:
        return estimate_tokens(wire_state(value) if isinstance(value, dict) else [wire_action(a) for a in value])

    # The person's task often opens the conversation too; it goes in once.
    messages = [m for m in conversation if not (m["role"] == "user" and task.strip() and m["text"].strip() == task.strip())]
    # Each asked sentence's best action line is kept before older messages take their room: a message
    # restating an earlier run ("both over the 0.65 bar", "206 of 210") was read as contradicting the
    # newer result, which it had pushed out. Older assistant messages go in only for what no action shows.
    best = earlier_lines(earlier + actions[:-1], evidence, stems, False, EARLIER_ACTIONS_TOKENS, per_sentence, only_sentences=True)
    best_cost = sum(ITEM_OVERHEAD_TOKENS + estimate_tokens(line) for line in best)
    message_room = OLDER_MESSAGES_TOKENS - min(OLDER_MESSAGES_TOKENS, best_cost * BEST_LINES_MESSAGE_SHARE)
    sentences = sentence_entries(summary)
    state = {
        "task": clip(task, TASK_CLIP_CHARS),
        "conversation": conversation_lines(messages, unbacked(evidence, "\n".join([*best, *(a["input"] + "\n" + a["result"] for a in actions)])), message_room),
        "actions": [],
        "earlier_actions": [],
        "sentences": [clip(s, CANDIDATE_CLIP_CHARS if i in asked else SENTENCE_CLIP_CHARS) for i, s in enumerate(sentences)],
    }
    # A long reply on its own: the sentences not asked about shrink, and then the older messages go.
    if cost(state) > budget:
        state["sentences"] = [s if i in asked else one_line(s, SENTENCE_SHORT_CHARS) for i, s in enumerate(state["sentences"])]
    if cost(state) > budget:
        state["conversation"] = state["conversation"][-CONVERSATION_MESSAGES:]
    if cost(state) > state_token_limit(scale):
        state["sentences"] = [s if i in asked else "…" for i, s in enumerate(state["sentences"])]
    # Past Jev's own limit even so (a reply of thousands of sentences): those after the last asked about go.
    if cost(state) > state_token_limit(scale):
        state["sentences"] = state["sentences"][: max(asked, default=-1) + 1]

    side_effects = any(_NEGATIVE_RE.search(plain_markdown(entries[i][1])) for i in asked)
    room = budget - cost(state)
    floor = max(EARLIER_FLOOR_TOKENS, best_cost) * scale
    reserve = estimate_tokens(earlier_lines(earlier, evidence, stems, side_effects, max(room, 0), per_sentence))
    whole = actions
    start_room = room
    actions = fill(actions, room - reserve, clipped, evidence, stems)
    kept = 0
    # Older actions asked the paltering question go in whatever else does, and the ones between them
    # and the newest that fit go as held entries (below): room is kept for those, and for the held
    # entries holding evidence, up to BRIEF_ACTIONS_TOKENS, so the state stays within its budget.
    target_cost = {j: ITEM_OVERHEAD_TOKENS + estimate_tokens(wire_action(actions[j])) for j in targets}
    # A failure a later run fixed (fixed_later) is not asked, but it still starts the held region: the
    # actions after it go as held entries whose evidence lines back the reply, as they did when it was
    # asked. Without that, 6 claim sentences over the 968 checks since 09-26 lost all their evidence;
    # with it, 1 does (a line only the fixed run's traceback printed).
    anchors = [j for j, a in enumerate(actions) if a["failed"] and not a["mechanics"]][-MAX_PALTER_ACTIONS:]
    held = {n: held_entry(actions[n], evidence) for n in range(anchors[0], len(actions)) if n not in targets} if anchors else {}
    held_evidence = [0.0] * (len(actions) + 1)
    for n in range(len(actions)):
        hits, short = held.get(n, (0, None))
        held_evidence[n + 1] = held_evidence[n] + (ITEM_OVERHEAD_TOKENS + estimate_tokens(wire_action(short)) if hits else 0)
    placeholder = ITEM_OVERHEAD_TOKENS + estimate_tokens(wire_action({"omitted": max(len(actions), 2)}))
    for n in range(len(actions) - 1, -1, -1):  # newest first, so the oldest are dropped
        step = ITEM_OVERHEAD_TOKENS + estimate_tokens(wire_action(actions[n]))
        older = [j for j in anchors if j < n]
        forced = [j for j in older if j in target_cost]
        pending = sum(target_cost[j] for j in forced)
        if older and n - older[0] > len(forced):
            pending += placeholder + min(held_evidence[n] - held_evidence[older[0]], BRIEF_ACTIONS_TOKENS * scale)
        if step > room - reserve - pending and kept:
            break
        room -= step
        kept += 1
    # An action asked the paltering question stays however old; the actions between it and those that
    # fit are held for their index, so the indices stay the turn's. Dropping them lost the 13:13
    # pipeline's three failures, which fell behind eleven newer actions at a budget of 1,300 tokens;
    # sending them as older-action lines with their results' ends made pipeline states 45% over budget,
    # and with no result, 18:08's "all 34 offline tests pass" lost the "Ran 34 tests" its middle action
    # printed. So they go as their input's first words and their result's evidence lines, those holding
    # the most evidence first, then the newest, in the room left (the loop above keeps
    # BRIEF_ACTIONS_TOKENS of it from the newer actions); each run of the rest is one "…N actions
    # omitted…" entry, and those join the older actions as lines.
    must = len(actions) - anchors[0] if anchors else 0
    omitted: list[dict] = []
    brief: set[int] = set()
    if kept < must:
        first, last = len(actions) - must, len(actions) - kept
        room -= sum(ITEM_OVERHEAD_TOKENS + estimate_tokens(wire_action(actions[n])) for n in range(first, last) if n in targets)
        stubs = {n: held[n] for n in range(first, last) if n in held}
        # Those holding evidence get BRIEF_ACTIONS_TOKENS even when the newest action took the room (the
        # actions sent whole are then cut shorter, below); the rest only the room left.
        evidence_room = max(room - reserve, BRIEF_ACTIONS_TOKENS * scale)
        stub_room = max(room - reserve, 0)
        chosen = set()
        for n in sorted(stubs, key=lambda n: (-stubs[n][0], -n)):
            step = ITEM_OVERHEAD_TOKENS + estimate_tokens(wire_action(stubs[n][1]))
            if stubs[n][0]:
                if step <= evidence_room:
                    evidence_room -= step
                    stub_room -= step
                    chosen.add(n)
                continue
            if step > stub_room:
                break  # a shorter older one would split a run of omitted ones
            stub_room -= step
            chosen.add(n)
        region: list[dict] = []
        run: list[dict] = []
        for n in range(first, last + 1):
            if n in stubs and n not in chosen:
                run.append(actions[n])
                continue
            if run:
                omitted += run
                region.append({"tool": "", "input": "", "result": "", "error": False, "failed": False, "mechanics": True,
                               "omitted": len(run), "turn": run[0]["turn"]})
                run = []
            if n < last:
                region.append(stubs[n][1] if n in chosen else actions[n])
        placed = [a for a in region if "omitted_lines" in a or a.get("omitted")]
        room -= sum(ITEM_OVERHEAD_TOKENS + estimate_tokens(wire_action(a)) for a in placed)
        actions = actions[:first] + region + actions[last:]
        kept = len(actions) - first
        brief = {n for n in range(first, len(actions)) if "omitted_lines" in actions[n] or actions[n].get("omitted")}
    # The newest action, and those asked the paltering question, go in even past the room: at the fixed
    # clips a headless pipeline's forced actions averaged 525 tokens over its budget of about 1,000. Those
    # sent whole or clipped are cut shorter until they fit, down to a floor.
    if room < 0:
        full = [n for n in range(len(actions) - kept, len(actions)) if n not in brief]
        held = sum(ITEM_OVERHEAD_TOKENS + estimate_tokens(wire_action(actions[n])) for n in brief)
        for n, a in zip(full, shrink([whole[actions[n]["turn"]] for n in full], start_room - reserve - held, evidence, stems)):
            actions[n] = a
        room = start_room - sum(ITEM_OVERHEAD_TOKENS + estimate_tokens(wire_action(a)) for a in actions[len(actions) - kept :])
    state["actions"] = actions[len(actions) - kept :]
    # The dropped actions still back up the summary: they join the earlier turns' actions as lines, and
    # get no paltering questions. They have a floor of room the newest action cannot take.
    older = earlier + actions[: len(actions) - kept] + omitted
    state["earlier_actions"] = earlier_lines(older, evidence, stems, side_effects, max(room, floor), per_sentence)
    change = rerun_change(whole[-1], earlier) if whole else None
    if change:
        state["earlier_actions"].append(change)
    return state, len(actions) - kept


# Actions that are the tools' own mechanics, not work: a call the tool rejected before running, a
# search for tool schemas, a command started in the background on request (one moved there by a
# timeout is kept). Replayed checks flagged these as paltering when the summary said nothing of
# them, though nothing about the work was hidden. They stay in the state as evidence; only their
# paltering question is left out.
_MECHANICS_TOOLS = ("ToolSearch",)
_MECHANICS_RESULTS = ("<tool_use_error>InputValidationError", "Command running in background with ID: ")


def is_mechanics(action: dict) -> bool:
    return action["tool"] in _MECHANICS_TOOLS or action["result"].lstrip().startswith(_MECHANICS_RESULTS)


def build_questions(state: dict, summary: str, scale: float = 1.0) -> tuple[dict, int, int]:
    """Return (questions, palter questions dropped, sentence questions dropped) to fit the 64k budget.

    Each sentence asked about (candidates) gets the questions route picks for it, as Jev reads it (under
    its heading); each action whose result shows a failure (palter_targets) gets the paltering question.
    Paltering questions for the oldest actions go first, then sentence questions from the end.
    """
    questions = {}
    entries = sentence_entries(summary)
    for i in candidates(summary):
        if i < len(state["sentences"]):
            for t in route(entries[i]):
                questions[f"{t}_s{i}"] = make_question(t, i)
    palter_ids = [f"{PALTER}_a{j}" for j in palter_targets(state["actions"])]
    for qid in palter_ids:
        questions[qid] = make_question(PALTER, int(qid.rsplit("_a", 1)[1]))

    room = REQUEST_TOKEN_LIMIT * scale / ESTIMATE_MARGIN - REQUEST_OVERHEAD_TOKENS - estimate_tokens(wire_state(state))
    room -= sum(question_tokens(q) for q in questions.values())
    drop_order = palter_ids + [qid for qid in reversed(questions) if not qid.startswith(PALTER)]
    dropped = []
    for qid in drop_order:
        if room >= 0:
            break
        if qid not in questions:
            continue
        # A composed decision needs all of its asked parts' answers. Drop the whole
        # group so a partial group cannot silently produce no decision.
        qtype, suffix = qid.rsplit("_", 1)
        group = [f"{part}_{suffix}" for part in COMPOSED[PART_OF[qtype]][0]] if qtype in PART_OF else [qid]
        for member in group:
            if member in questions:
                room += question_tokens(questions.pop(member))
                dropped.append(member)
    dropped_palters = sum(1 for qid in dropped if qid.startswith(PALTER))
    return questions, dropped_palters, len(dropped) - dropped_palters


_LOCAL_HOSTS = ("localhost", "127.0.0.1", "::1")


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Never follow redirects: urllib would resend the Authorization header to wherever they point."""

    def redirect_request(self, *args, **kwargs):
        return None  # the 3xx surfaces as an HTTPError, which fails open


_OPENER = urllib.request.build_opener(_NoRedirect)


def jev_url() -> str:
    """The Jev endpoint. The API key is sent to it, so only https is allowed, except to this machine."""
    base_url = (os.environ.get("TYPESAFE_BASE_URL", "").strip() or DEFAULT_BASE_URL).rstrip("/")
    parts = urllib.parse.urlsplit(base_url)
    if parts.scheme != "https" and not (parts.scheme == "http" and parts.hostname in _LOCAL_HOSTS):
        raise ValueError(f"TYPESAFE_BASE_URL must be an https URL, got {base_url!r}")
    return base_url + SYSTEM_ONE_PATH


class JevTooLong(ValueError):
    """Jev refused the request as over its token limits (HTTP 400 max_tokens_exceeded)."""


def ask_jev(state: dict, questions: dict, api_key: str, deadline: float) -> dict:
    """POST to Jev, giving up at the time.monotonic() deadline.

    urlopen's timeout applies to each socket operation (and not to DNS), so a slow or trickling
    response could run far past it. The call runs in a daemon thread that is abandoned on timeout.
    """
    outcome: dict = {}

    def call():
        try:
            outcome["response"] = _post_jev(state, questions, api_key)
        except urllib.error.HTTPError as error:
            body = error.read()[:500].decode(errors="replace")
            if error.code == 400 and "max_tokens_exceeded" in body:
                outcome["error"] = JevTooLong(f"HTTP 400: {body}")
            else:
                outcome["error"] = ValueError(f"HTTP {error.code}: {body}")
        except BaseException as error:  # re-raised in the calling thread
            outcome["error"] = error

    worker = threading.Thread(target=call, daemon=True)
    worker.start()
    worker.join(max(0.0, deadline - time.monotonic()))
    if worker.is_alive():
        raise TimeoutError(f"no answer within {JEV_TIMEOUT_SECONDS:g} seconds")
    if "error" in outcome:
        raise outcome["error"]
    return outcome["response"]


def _post_jev(state: dict, questions: dict, api_key: str) -> dict:
    body = json.dumps({"state": state, "model": JEV_MODEL, "questions": questions}).encode()
    request = urllib.request.Request(
        jev_url(),
        data=body,
        method="POST",
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": "jev-no-bullshit",
        },
    )
    with _OPENER.open(request, timeout=JEV_TIMEOUT_SECONDS) as response:
        return json.loads(response.read())


def noul_values(response: dict) -> dict[str, float]:
    answers = response.get("answers")
    if not isinstance(answers, dict):
        raise ValueError("Jev response has no answers")
    values = {}
    for qid, answer in answers.items():
        if isinstance(answer, dict) and isinstance(answer.get("noul"), (int, float)):
            values[qid] = float(answer["noul"])
    return values


def compose(values: dict[str, float], questions: dict) -> dict[str, float]:
    """Combine each composed type's part answers into its decision score, per sentence (see COMPOSED).

    Max is an OR and min an AND of decision scores, not calibrated probabilities. A part that was not
    asked of a sentence (see route) counts as 0; a sentence gets a decision only when every part that
    was asked was answered, rather than treating a missing answer as zero.
    """
    composed = {}
    for t, (parts, combine) in COMPOSED.items():
        suffixes = dict.fromkeys(qid.rsplit("_", 1)[1] for qid in questions if PART_OF.get(qid.rsplit("_", 1)[0]) == t)
        for suffix in suffixes:
            ids = [f"{part}_{suffix}" for part in parts]
            if all(i in values for i in ids if i in questions):
                composed[f"{t}_{suffix}"] = combine({part: values.get(f"{part}_{suffix}", 0.0) if f"{part}_{suffix}" in questions else 0.0 for part in parts})
    return composed


def find_flags(values: dict[str, float], thresholds: dict[str, float]) -> dict[str, list[str]]:
    """Map each flagged type to the question ids whose answers passed its threshold."""
    flagged: dict[str, list[str]] = {}
    for qid, value in values.items():
        qtype = qid.rsplit("_", 1)[0]
        if qtype in thresholds and value > thresholds[qtype]:
            flagged.setdefault(qtype, []).append(qid)
    for ids in flagged.values():
        ids.sort(key=lambda q: int(q.rsplit("_", 1)[1][1:]))
    return flagged


def callout_key(qid: str, state: dict) -> str:
    """Name a flag by what it points at, not its index: indices shift between attempts."""
    qtype, ref = qid.rsplit("_", 1)
    index = int(ref[1:])
    if qtype == PALTER:
        action = state["actions"][index]
        # Named by the action before clipping (callout_target): how much of it is kept changes with the
        # reply and the room. An action given without that name, as in tests, is named as it stands.
        target = action.get("callout") or callout_target(action)
    else:
        target = one_line(state["sentences"][index], SENTENCE_CLIP_CHARS)
    return hashlib.sha256(f"{qtype}\0{target}".encode()).hexdigest()[:16]


def drop_repeats(flagged: dict[str, list[str]], state: dict, callouts: dict, limit: int):
    """Split flags into those still under the per-item limit and those already called out enough."""
    kept: dict[str, list[str]] = {}
    repeats: dict[str, list[str]] = {}
    for t, ids in flagged.items():
        for qid in ids:
            target = repeats if callouts.get(callout_key(qid, state), 0) >= limit else kept
            target.setdefault(t, []).append(qid)
    return kept, repeats


