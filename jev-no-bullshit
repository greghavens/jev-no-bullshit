def given_turn(hook_input: dict) -> tuple[str, list[dict], str | None, int, list[dict]]:
    """Return (task, actions, model, tool calls still without a result, earlier actions) as a plugin sent them."""

    def actions(key: str) -> list[dict]:
        calls = hook_input.get(key)
        return [
            make_action(str(c.get("tool") or ""), c.get("input"), c.get("result"), bool(c.get("error")))
            for c in calls if isinstance(c, dict)
        ] if isinstance(calls, list) else []

    now = actions("actions")
    pending = sum(1 for a in now if a["result"] == NO_RESULT)
    return str(hook_input.get("task") or "").strip(), now, hook_input.get("model") or None, pending, actions("earlier_actions")


def given_conversation(hook_input: dict) -> list[dict]:
    """The messages before the reply as a plugin sent them, if it did."""
    messages = hook_input.get("conversation")
    given = [
        {"role": str(m.get("role") or ""), "text": str(m.get("text") or "")}
        for m in messages if isinstance(m, dict) and str(m.get("text") or "").strip()
    ] if isinstance(messages, list) else []
    return [{"role": "hook", "text": plugin_note(m["text"])} if MARKER in m["text"][:300] else m for m in given]


def run(hook_input: dict) -> dict | None:
    """Check one Stop event. Return the hook output to print, or None to let the turn end."""
    session_id = str(hook_input.get("session_id") or "unknown")
    host = hook_input.get("host") if isinstance(hook_input.get("actions"), list) else None
    is_codex = host is None and "turn_id" in hook_input
    tool = str(host) if host else "codex" if is_codex else "claude"
    # In Claude Code the hooks module (hooks/jev.tsx) runs this script before the plain Stop hook in
    # hooks/hooks.json. It marks the reply it checked, and the plain hook then stands down. Where
    # Claude Code does not load modules, nothing marks the reply and the plain hook checks it.
    module = os.environ.get("JEV_NO_BULLSHIT_MODULE") == "1"
    if tool == "claude":
        digest = reply_digest(hook_input.get("last_assistant_message") or "")
        mark = module_mark_path(session_id)
        if module:
            try:
                private_dir("state")
                mark.write_text(digest)
            except OSError:
                pass
        else:
            try:
                if mark.read_text() == digest:
                    return None
            except OSError:
                pass
    # Claude Code's hooks module (hooks/jev.tsx) sends feedback as a prompt, not a Stop block, so it
    # marks the turns that feedback started through the environment instead of stop_hook_active.
    redirected = bool(hook_input.get("stop_hook_active")) or os.environ.get("JEV_NO_BULLSHIT_REDIRECT") == "1"
    counters = load_counters(session_id, redirected)
    base = {"session_id": session_id, "tool": tool, "attempt": counters["attempt"]}

    summary = hook_input.get("last_assistant_message") or ""
    if not summary.strip():
        log({**base, "skipped": "no last_assistant_message"})
        return None
    if counters["attempt"] >= max_redirects():
        # Flags now could only be logged, never sent: 6.8% of the tokens billed from 09-26 to 09-30.
        log({**base, "skipped": "redirects used up", "summary": summary})
        return None

    if host:
        task, actions, transcript_model, pending, earlier = given_turn(hook_input)
        conversation = given_conversation(hook_input)
    else:
        task, actions, transcript_model, pending, earlier = read_transcript(
            hook_input.get("transcript_path"), parse_codex if is_codex else parse_claude
        )
        conversation = (conversation_codex if is_codex else conversation_claude)(
            read_jsonl(hook_input.get("transcript_path")), summary
        )
    model = (hook_input.get("model") if is_codex else None) or transcript_model or "the model"

    thresholds = {t: threshold(t) for t in TYPES}
    base.update(thresholds=thresholds, missing_tool_results=pending)
    deadline = time.monotonic() + JEV_TIMEOUT_SECONDS
    key = None
    # The token count is an estimate; if Jev still finds the request too long, retry once with a smaller budget.
    for scale in (1.0, RETRY_BUDGET_SCALE):
        state, dropped_actions = build_state(task, actions, summary, earlier, conversation, scale)
        questions, dropped_palters, dropped_sentence_qs = build_questions(state, summary, scale)
        sent = wire_state(state)
        base.update(
            dropped_actions=dropped_actions,
            dropped_palter_questions=dropped_palters,
            dropped_sentence_questions=dropped_sentence_qs,
            estimated_tokens=round(
                REQUEST_OVERHEAD_TOKENS + estimate_tokens(sent) + sum(map(question_tokens, questions.values()))
            ),
        )
        if not questions:
            # No sentence worth asking about and no failed action: nothing Jev could flag, and nothing sent.
            # Its key is not looked for, so such a reply never says it was not checked.
            log({**base, "estimated_tokens": 0, "skipped": "nothing to check", "summary": summary})
            return None
        if key is None:
            try:
                key = api_key()
            except ValueError as refused_key:
                key, error = "", str(refused_key)
            else:
                error = f"TYPESAFE_API_KEY is not set in this environment or in {key_file()}"
            if not key:
                log({**base, "error": error, "summary": summary})
                return unchecked(error)
        if base.get("refused_estimated_tokens", float("inf")) <= base["estimated_tokens"]:
            # Everything already fit the smaller budget, so the refusal isn't about size: don't resend it.
            error = f"Jev call failed: {type(refused).__name__}: {refused}"
            log({**base, "error": error, "summary": summary})
            return unchecked(error)
        try:
            response = ask_jev(sent, questions, key, deadline)
            values = noul_values(response)
            break
        except (urllib.error.URLError, OSError, ValueError, TypeError) as error:
            if isinstance(error, JevTooLong) and scale == 1.0:
                # Jev's refusal gives no count, so the estimate it refused is what to recalibrate from.
                base["refused_estimated_tokens"] = base["estimated_tokens"]
                refused = error
                continue
            message = f"Jev call failed: {type(error).__name__}: {error}"
            log({**base, "error": message, "summary": summary})
            return unchecked(message)

    # Answers without a numeric noul are ignored; log them, or an API change would silently flag nothing.
    unanswered = sorted(set(questions) - set(values))
    composed = compose(values, questions)
    decision_values = {**values, **composed}
    flagged, repeats = drop_repeats(find_flags(decision_values, thresholds), state, counters["callouts"], max_callouts())
    redirect = bool(flagged)
    log(
        {
            **base,
            "jev_model": response.get("model"),
            "usage": response.get("usage"),
            "answers": values,
            "composed_scores": composed,
            **({"unanswered": unanswered} if unanswered else {}),
            "flagged": flagged,
            **({"repeats": repeats} if repeats else {}),
            "redirected": redirect,
            "summary": summary,
        }
    )
    if not redirect:
        return None

    counters["attempt"] += 1
    for t, ids in flagged.items():
        counters["flags"][t] += 1
        for qid in ids:
            key = callout_key(qid, state)
            counters["callouts"][key] = counters["callouts"].get(key, 0) + 1
    save_counters(session_id, counters)
    output = {"decision": "block", "reason": build_reason(flagged, state, dropped_actions)}
    if tool != "claude" or not module:  # in Claude Code the module sends the reason itself as a prompt
        output["systemMessage"] = (
            f"Asking {model} to reconsider its response after bullshit detection, attempt #{counters['attempt']}"
        )
    return output


def main() -> int:
    try:
        hook_input = json.loads(sys.stdin.read() or "{}")
        if not isinstance(hook_input, dict):
            raise ValueError("hook input is not a JSON object")
        output = run(hook_input)
    except Exception as error:  # fail open: never trap the model
        message = f"unexpected: {type(error).__name__}: {error}"
        log({"error": message})
        output = unchecked(message)
    if output is not None:
        sys.stdout.write(json.dumps(output))
    return 0


if __name__ == "__main__":
    sys.exit(main())
